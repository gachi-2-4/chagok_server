# docker compose용 환경변수 예시. 복사해서 쓰세요: cp .env.example .env
# .env는 커밋하지 않습니다 (.gitignore에 포함). 아래 값은 로컬 개발용 더미 값입니다.

# ---- MySQL (compose가 만드는 컨테이너) ----
MYSQL_DATABASE=chagok
DB_USERNAME=chagok
DB_PASSWORD=change-me-db-password
# 호스트에서 접속할 포트 (IDE에서 앱을 돌릴 때 jdbc:mysql://localhost:3306/chagok)
MYSQL_PORT=3306

# ---- Redis (compose가 만드는 컨테이너) ----
# 아직 앱에서 쓰지 않습니다. 필요해지면 바로 붙일 수 있게 띄워 둡니다.
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

# ---- 앱 ----
APP_PORT=8080
# 로컬 compose에서는 테이블을 자동으로 만듭니다. 운영에서는 validate 또는 none만 쓰세요.
DDL_AUTO=update

# 인증
JWT_SECRET=local-dev-jwt-secret-local-dev-jwt-secret-0123456789
SMS_HASH_SECRET=local-dev-sms-hash-secret
TWILIO_ACCOUNT_SID=ACdummy
TWILIO_AUTH_TOKEN=dummy
TWILIO_FROM=+10000000000

# 소셜 로그인 (KAKAO_APP_ID는 숫자여야 합니다)
KAKAO_CLIENT_ID=dummy
KAKAO_APP_ID=0
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=http://localhost:8080/oauth/kakao
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google

# AI 서버 -> BE 내부 API 인증 키, BE -> AI 서버 호출 주소·키
CHAGOK_INTERNAL_KEY=local-dev-internal-key
# 호스트에서 돌리는 AI 서버를 가리키는 예 (컨테이너 안에서 호스트로 접속)
AI_SERVER_URL=http://host.docker.internal:8000
AI_SERVER_API_KEY=local-dev-ai-key

# 서류 파일 저장소(S3). 실제 S3를 쓰려면 버킷과 AWS 자격 증명을 채우세요.
S3_BUCKET=chagok-local
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# FCM 푸시 (비워 두면 푸시를 로그로만 남깁니다)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
